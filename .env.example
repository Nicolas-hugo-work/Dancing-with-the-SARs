# Copia este archivo como .env (nunca se versiona) y completa los valores vacíos.
# Genera secretos con:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# Docker Compose interpola '$': si un valor contiene '$', escríbelo entre comillas simples.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Incluye localhost y 127.0.0.1: el healthcheck del contenedor web consulta 127.0.0.1.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes separados por comas que pueden consumir la API (vacío = ninguno).
CORS_ALLOWED_ORIGINS=

# PostgreSQL + PostGIS (las usan tanto el servicio db como el servicio web)
POSTGRES_DB=sat_cochabamba
POSTGRES_USER=sat
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# WMS del GAMC (proxy de solo lectura). La clave del proyecto la entrega el GAMC:
# va solo en el .env local; no la copies en código, pruebas, issues ni capturas.
GAMC_WMS_URL=https://serviciosgamc.cochabamba.bo/api/gs/wms
GAMC_WMS_CLAVE=
